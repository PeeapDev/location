# Sierra Leone Postal Address System - Environment Configuration
# Copy this to .env and fill in your values

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get these from your Supabase project: Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Database URL (Supabase PostgreSQL connection string)
# Get from: Settings > Database > Connection string > URI
# Replace [YOUR-PASSWORD] with your database password
DATABASE_URL=postgresql+asyncpg://postgres.[project-id]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=Xeeno Map
APP_VERSION=0.1.0
DEBUG=false

# Secret key for JWT tokens (generate a random string)
SECRET_KEY=your-secret-key-change-in-production

# =============================================================================
# GOOGLE MAPS (Optional - for geocoding fallback)
# =============================================================================
GOOGLE_MAPS_API_KEY=

# =============================================================================
# CORS ORIGINS (comma-separated)
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-frontend.vercel.app

# =============================================================================
# GPS SETTINGS
# =============================================================================
GPS_ACCURACY_EXCELLENT=5.0
GPS_ACCURACY_GOOD=10.0
GPS_ACCURACY_ACCEPTABLE=25.0
