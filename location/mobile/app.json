{
  "expo": {
    "name": "Xeeno Map",
    "slug": "xeeno-map-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "xeenomap",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1E40AF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xeenomap.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Xeeno Map needs your location to generate accurate Plus Codes and register addresses.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Xeeno Map needs your location to generate accurate Plus Codes and register addresses."
      }
    },
    "android": {
      "package": "com.xeenomap.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Xeeno Map needs your location to generate accurate Plus Codes and register addresses."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3f9e7a84-2bc2-42a9-8093-786fad2ce681"
      }
    },
    "owner": "perap_pay"
  }
}
